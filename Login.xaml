<Window x:Class="DataVirtualization.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataVirtualization"
        mc:Ignorable="d"
        Title="Login" Height="422" Width="497"  WindowStartupLocation="CenterScreen">

    <Window.Background>
        <ImageBrush ImageSource="Images/rectangle_1.jpeg" Stretch="Fill" />
    </Window.Background>

    <Grid Margin="0,0,-75,-52">

        <Image Source="images/logonobg.png" Width="146" Height="141" 
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" />
        <!-- Username Label -->
        <Label Content="Username:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="55,189,0,0" FontSize="18" />
        <!-- Username TextBox -->
        <TextBox x:Name="UsernameTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="236,191,0,0" FontSize="18" />

        <!-- Password Label -->
        <Label Content="Password:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="55,221,0,0" FontSize="18" />
        <!-- Password PasswordBox -->
        <PasswordBox x:Name="PasswordBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="236,229,0,0" FontSize="18" />

        <!-- Login Button -->
        <Button Content="Login" Width="146" Height="39" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="190,297,0,0" Click="LoginButton_Click" FontSize="18" />
    </Grid>
</Window>

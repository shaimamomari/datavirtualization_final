                <TextBox x:Name="tbNumItems" Margin="5" Text="13000000" Width="60" VerticalAlignment="Center"/>
                <TextBlock Text="Fetch Delay (ms):" Margin="5" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="tbFetchDelay" Margin="5" Text="1000" Width="60" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Collection">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">

                    <TextBlock Text="Page size:" Margin="5" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbPageSize" Margin="5" Text="900000" Width="60" VerticalAlignment="Center"/>
                    <TextBlock Text="Result Count :" Margin="5" VerticalAlignment="Center" Width="76"/>




                    <TextBlock Width="80" x:Name="tbResultCount" Height="16" 
           Text="{Binding Path=Count, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="chkActiveActions" Content="ActiveActions" VerticalAlignment="Center" Checked="chkActiveActions_Checked" Unchecked="chkActiveActions_Unchecked" IsChecked="True" Margin="0,0,5,0"/>
                        <CheckBox x:Name="chkToday"    Content="Today" VerticalAlignment="Center" Checked="chkToday_Checked" Unchecked="chkToday_Unchecked" IsChecked="True" Margin="0,0,5,0"/>
                        <CheckBox x:Name="chkCurrentYear"   Content="Current Year" VerticalAlignment="Center" Checked="chkCurrentYear_Checked" Unchecked="chkCurrentYear_Unchecked"  Margin="0,0,20,0"/>
                    </StackPanel>



                    <!-- CheckBox for History -->
                    <CheckBox x:Name="chkHistory" Content="History" Margin="5" VerticalAlignment="Center" Checked="chkHistory_Checked" Unchecked="chkHistory_Unchecked"/>

                    <!-- StackPanel for Date Pickers, initially hidden -->






                    <StackPanel x:Name="spHistoryOptions" Orientation="Horizontal" Visibility="Collapsed" Margin="5,0,0,0">

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="From:" VerticalAlignment="Center" />
                            <TextBox Name="source_file_FromDateTextBox" Width="100" Height="17" Margin="5,0,0,0" IsReadOnly="True" />
                            <Image Source="calendar.png" Margin="3,0,0,0" Width="20" Height="20" MouseLeftButtonDown="source_file_FromDateIcon_MouseLeftButtonDown" Cursor="Hand" />
                            <Popup Name="source_file_FromDatePopup" PlacementTarget="{Binding ElementName=source_file_FromDateTextBox}" StaysOpen="True">
                                <Calendar Name="FromDateCalendar" SelectedDatesChanged="FromDate_source_file_Calendar_SelectedDatesChanged"
Tag="{Binding ElementName=source_file_FromDatePopup}" />
                            </Popup>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,2,0,0">
                            <TextBlock Text="To:    " VerticalAlignment="Center" />
                            <TextBox Name="source_file_ToDateTextBox" Width="100"  Height="17" Margin="5,0,0,0" IsReadOnly="True" />
                            <Image Source="calendar.png"  Margin="3,0,0,0" Width="20" Height="20" MouseLeftButtonDown="source_file_ToDateIcon_MouseLeftButtonDown" Cursor="Hand" />
                            <Popup Name="source_file_ToDatePopup" PlacementTarget="{Binding ElementName=source_file_ToDateTextBox}" StaysOpen="True">
                                <Calendar Name="ToDateCalendar" SelectedDatesChanged="ToDate_source_file_Calendar_SelectedDatesChanged"
Tag="{Binding ElementName=source_file_ToDatePopup}" />
                            </Popup>
                        </StackPanel>
                    </StackPanel>

                    <!-- Popup for DatePicker -->
                    <Button Content="GET" Click="Button_Click" Margin="5" Width="100" VerticalAlignment="Center"/>
                </StackPanel>







            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <TextBlock Text="Memory Usage:" Margin="5" VerticalAlignment="Center"/>
            <TextBlock x:Name="tbMemory" Margin="5" Width="80" VerticalAlignment="Center"/>



        </StackPanel>




        <ListView x:Name="lvStyle" Grid.Row="3" Margin="5,5,5,360" Style="{DynamicResource lvStyle}" ItemContainerStyle="{StaticResource ListViewItemStyle}"/>

        <!-- New ListView added below the existing one -->
        <ListView  x:Name="lvStyle2" Grid.Row="4" Margin="5,700,5,5" Style="{DynamicResource lvStyle2}" ItemContainerStyle="{StaticResource ListViewItemStyle}"/>
    </Grid>
</UserControl>


    

<UserControl  x:Class="DataVirtualization.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Style for ListView -->
        <!-- Shaima -->

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="lvStyle" TargetType="{x:Type ListView}">
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="dg1_MouseLeftButtonUp"/>
            <Setter Property="ListView.ItemsSource" Value="{Binding}"/>

            <Setter Property="ListView.View">
                <Setter.Value>
                    <GridView>
                        <GridViewColumn Header="Id" Width="100">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="Id"/>
                                        <TextBox Width="90" Margin="0,2,0,0" TextChanged="OnFilterTextChanged"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Column for Name -->
                        <GridViewColumn Header="Order ID" Width="150">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Order ID"/>
                                            <!-- Filter Icon -->
                                            <ToggleButton x:Name="FilterToggleButton" Width="16" Height="16" Margin="5,0,0,0"
                                  Content="🔍" IsChecked="False">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Background" Value="LightGray"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                        </StackPanel>

                                        <!-- TextBox -->
                                        <TextBox Width="140" Margin="0,2,0,0" 
                         TextChanged="OnNameFilterTextChanged"
                         Visibility="{Binding IsChecked, ElementName=FilterToggleButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>















                        <!-- Column for Validity Date -->
                        <GridViewColumn Header="Entry Date" Width="250">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Entry Date" />
                                            <!-- Filter Icon -->
                                            <ToggleButton x:Name="FilterToggleButton" Width="16" Height="16" Margin="5,0,0,0"
           Content="🔍"  IsChecked="False">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="IsChecked" Value="False"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Background" Value="LightGray"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                        </StackPanel>

                                        <!-- Filter Controls -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding IsChecked, ElementName=FilterToggleButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="From:" VerticalAlignment="Center" />
                                            <TextBox Name="FromDateTextBox" Width="100" Margin="5,0,0,0" IsReadOnly="True" />
                                            <Image Source="calendar.png" Width="20" Height="20" MouseLeftButtonDown="FromDateIcon_MouseLeftButtonDown" Cursor="Hand" />
                                            <Popup Name="FromDatePopup" PlacementTarget="{Binding ElementName=FromDateTextBox}" StaysOpen="True">
                                                <Calendar Name="FromDateCalendar" SelectedDatesChanged="FromDateCalendar_SelectedDatesChanged"
Tag="{Binding ElementName=FromDatePopup}" />
                                            </Popup>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding IsChecked, ElementName=FilterToggleButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="To:    " VerticalAlignment="Center" />
                                            <TextBox Name="ToDateTextBox" Width="100" Margin="5,0,0,0" IsReadOnly="True" />
                                            <Image Source="calendar.png" Width="20" Height="20" MouseLeftButtonDown="ToDateIcon_MouseLeftButtonDown" Cursor="Hand" />
                                            <Popup Name="ToDatePopup" PlacementTarget="{Binding ElementName=ToDateTextBox}" StaysOpen="True">
                                                <Calendar Name="ToDateCalendar" SelectedDatesChanged="ToDateCalendar_SelectedDatesChanged"
Tag="{Binding ElementName=ToDatePopup}" />
                                            </Popup>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>

                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding entry_date}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>









                        <GridViewColumn Header="Status" Width="150">

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Status"/>
                                            <!-- Filter Icon -->
                                            <ToggleButton x:Name="FilterToggleButton" Width="16" Height="16" Margin="5,0,0,0"
                                  Content="🔍"  IsChecked="False">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="IsChecked" Value="False"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Background" Value="LightGray"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                        </StackPanel>
                                        <!-- ComboBox -->
                                        <ComboBox x:Name="StatusComboBox" Width="140" Margin="0,2,0,0" SelectionChanged="OnStatusFilterChanged"
                          Visibility="{Binding IsChecked, ElementName=FilterToggleButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ComboBoxItem Content="All" Tag=""/>
                                            <ComboBoxItem Content="Remaining" Tag="R"/>
                                            <ComboBoxItem Content="Finished" Tag="F"/>
                                            <ComboBoxItem Content="Modified" Tag="M"/>
                                            <ComboBoxItem Content="Canceled" Tag="C"/>
                                            <ComboBoxItem Content="Executed" Tag="TX"/>
                                            <ComboBoxItem Content="Partially executed" Tag="X"/>
                                            <ComboBoxItem Content="Rejected" Tag="R"/>
                                        </ComboBox>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding status, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>



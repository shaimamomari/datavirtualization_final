        <!-- Style for ListViewItem to change background color based on status -->
        <Style x:Key="ListViewItemStyle" TargetType="ListViewItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="R">
                    <Setter Property="Background" Value="Red"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="M">
                    <Setter Property="Background" Value="#f0c2f0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="C">
                    <Setter Property="Background" Value="#08a8a8"/>
                </DataTrigger>



                <DataTrigger Binding="{Binding status}" Value="TX">
                    <Setter Property="Background" Value="#bff0bb"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding status}" Value="X">
                    <Setter Property="Background" Value="#faf6a7"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding status}" Value="XT">
                    <Setter Property="Background" Value="#bff0bb"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding status}" Value="MX">
                    <Setter Property="Background" Value="#d5cef2"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding status}" Value="CX">
                    <Setter Property="Background" Value="#f5f5f5"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding status}" Value="F">
                    <Setter Property="Background" Value="#8dadf7"/>
                </DataTrigger>





                <DataTrigger Binding="{Binding status}" Value="T">
                    <Setter Property="Background" Value="#7678f5"/>
                </DataTrigger>


                <DataTrigger Binding="{Binding status}" Value="OK">

<Window x:Class="DataVirtualization.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataVirtualization"
        mc:Ignorable="d"
        Title="HomeWindow" Height="450" Width="800">

    <Grid>
        <!-- Row definitions: One for the menu, one for the content -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- For the Menu -->
            <RowDefinition Height="*"/>
            <!-- For the TabControl -->
        </Grid.RowDefinitions>

        <!-- Menu placed in the first row -->
        <Menu VerticalAlignment="Top" Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="Save" Click="SaveMenuItem_Click"/>
                <MenuItem Header="Restart" Click="RestartMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Views">

                <MenuItem Header="Actions" >
                    <MenuItem Header="New Tab" Click="ActionsMenuItem_Click" Tag="NewTab"/>
                    <MenuItem Header="New Window" Click="ActionsMenuItem_Click"  Tag="NewWindow"/>
                </MenuItem>
                
                
              
                <MenuItem Header="Active Clients" Click="ActiveClientsMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- TabControl placed in the second row -->
        <TabControl x:Name="MainTabControl" Grid.Row="1">
            <TabItem Header="Home">
                <TextBlock Text="Welcome to the Home Tab" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
